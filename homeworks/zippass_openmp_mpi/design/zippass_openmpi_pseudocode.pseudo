//zippass_serial_pseudocode_solution

procedure main (num_args, argument[]):
    if(num_args != ) then
        declare file_txt := read_txt_file(argument[1])
        // Read a .txt file
        //Read num of threads
        declare num_threads := argument[2]

        Init Distribution

        Distribute each zip file to one process
         seach_zips_passwords(file_txt,num_threads)

         Finalize Distribution


procedure read_txt_file:
    file = open_file(argument[1])
    if(file = NULL) then:
        print ("The file could not be open")
        return null
    else
     
     // Read maximum password length from the .txt file
    declare MAX_PASSWORD_LENGHT = file(read second line)
    // Read the allowed alphabet from the .txt file
    declare ALPHABET [MAX_PASSWORD_LENGHT]= file( read first line)
    // "ALPHABET" will be the characters that can be contained
    // in a password of an protected ZIP file
    
    skip blank line from txt file

    / Read the list of ZIP files from .txt file.
    // and make an array with those list of ZIP files
 
    declare zip_files_directions[]
    declare num_zip_files := 0
    while(is_not_end_of_line) do
        zip_files_direccionts = file(read_zip_direction)      
        num_zip_files := +1;
    file = close file.


Procedure search_zips_passwords(txt data)

    
    declare program_error_code error_code := 0
    
   declare  zip_files_passwords* zips_passwords := structure zip_files_passwords
    declare zips_passwords->num_threads := num_threads
    
    declare zip_files_passwords.zip_dir = txt_data.zip_dir
    
    thread_pass_search_info* thread_info[num_threads] := structure thread_pass_search_info
 
    FOR i := 0 to txt_data.num_of_zip_files - 1 doend
    thread_info[i].alphabet := txt_data->alphabet
    thread_info[i].pass_is_found := zip_password_found[i]
    thread_info[i].password_file := NULL
    thread_info[i].password_length := txt_data.max_password_length
    thread_info[i].zip_file_dir := zips_passwords.zip_files_dir[i]
    thread_info[i].stat := ZIP_NOT_PROCESSED
    thread_info[i].num_threads := zips_passwords->num_threads

    find_password(thread_info[i])

Procedure find_password(structure thread_pass_search_info thread_info)

    declare uint64_t pass_length_counter := 1
    declare bool generate_more_password := true

    declare uint64_t* thread_id_found_pass := allocate memory for uint64_t variable
    declare thread_id_found_pass := 0

    WHILE (pass_length_counter <= thread_info->password_length AND generate_more_password) DO
        uint64_t total_combinations := pow_u(alphabet, pass_length_counter)
        char** passwords :=  generate_passwords(passwords, alphabet, pass_length_counter)
        declare  thread_passwords[num_threads] := structure thread_test_passwords

            thread_passwords.pass_is_found := pass_is_found
            thread_passwords.password_file := NULL
            thread_passwords.stat := stat
            thread_passwords.thread_id := i
            thread_passwords.thread_id_found_pass := thread_id_found_pass
            thread_passwords.passwords := passwords
            thread_passwords.zip_file_dir := zip_file_dir

            thread_passwords[i].start_index := i * amount_passwords_thread + min_val(i, mod_val(total_combinations, num_threads))

                FOR i := 0 to num_threads - 1 DO
                IF ((i + 1) < num_threads) THEN
                    thread_passwords[i].finish_index := thread_passwords[i + 1].start_index
                ELSE
                    thread_passwords[i].finish_index := total_combinations

                    FOR i := 0 to num_threads - 1 DO
                    pthread_create(threads[i], NULL, thread_test_passwords, thread_passwords[i])

                    FOR i := 0 to num_threads - 1 DO
                    pthread_join(threads[i], NULL)


                    IF (stat != ZIP_NOT_PROCESSED) THEN
                    generate_more_password := false
                    
            pass_length_counter++


procedure generate_zip_passwords(password_lenght, ALPHABET, generated_password, zip_file):
// Generate all possible combinations of characters of
// the current password length using the allowed alphabet.
// Make an array of character and store all posible combinations

    declare num_position :=0
    declare password_generated[password_lenght];
    declare password_temp[]
    declare is_password_found
    // 
    declare pass_counter
    while(pass_counter < password_lenght) do 
        for( alphabet_char :=0 to alphabet_last_character) do 
        password_temp[pos] = ALPHABET[i]    
      password_generated[pass_counter := password_temp]


procedure thread_test_passwords(structure test_passwords)

      declare structure thread_pass _test := pass_test
      pass_test.mutex_pass := test_passwords.mutex_pass
      pass_test.pass_is_found := false
      pass_test.password_file := NULL
      pass_test.stat := test_passwords.stat
      pass_test.zip_file_dir := test_passwords.zip_file_dir
      
      declare int password_counter := test_passwords.start_index
      WHILE (password_counter < test_passwords.finish_index AND generate_more_passwords) DO
          pass_test.password := test_passwords.passwords[password_counter]
      
          open_file(pass_test)
      
          IF (test_passwords.stat != ZIP_NOT_PROCESSED) THEN
              generate_more_passwords := false

      
          password_counter := password_counter + 1
      
      IF (pass_test.pass_is_found) THEN

          thread_id_found_pass := test_passwords.thread_id
          test_passwords.password_file := string password
           test_passwords.pass_is_found := true

procedure open_file (structure thread_pass test_pass)
    declare zip_file_data := zip_open(test_info.zip_file_dir, 0, NULL)

    declare num_files := zip_get_num_entries(zip_file_data, 0)

    For i = 0 to num_files DO
        declare file_stat := struct zip_stat
        
        declare file := zip_fopen_index_encrypted(zip_file_data, i, 0, test_info.password)
        IF (file is not NULL) THEN
            declare file_content := string
            file_characters := "CI0117-23a"
            declare char_count := zip_fread(file, file_content, file_stat.size)

            IF (char_count > 0) THEN
                IF (strncmp(file_characters, file_content, file_stat.size) = 0) THEN
                    test_info.pass_is_found := true
                    test_info.stat := ZIP_PROCESSED_SUCCESSFULLY
                    test_info.password_file := test.password
                    RETURN
    RETURN

